# Build output. Unanchored so a build directory created anywhere in the tree is
# ignored, not just one at the root - a stray nested build/ otherwise gets
# committed and trips the repository checks on CMake's own generated files.
build/
build-*/
/out/
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exe
*.pdb
*.ilk
*.exp

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
.ninja_deps
.ninja_log
build.ninja
rules.ninja

# Rust build output. CARGO_TARGET_DIR is redirected into the CMake build
# directory, but a stray `cargo build` run by hand lands here.
/rust/target/
rust-target/

# Cooked content and derived data (regenerable by definition)
/derived/
/cooked/
/.ddc/

# Editor and OS noise
.vscode/
.vs/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Test and profiling output
/testresults/
/captures/
*.trace
